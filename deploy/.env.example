# .env.example — copy to .env on the Oracle VM and fill in real values.
# NEVER commit .env to git.

# ── Bot identity ──────────────────────────────────────────────────────────────
BOT_NAME=Alex
BOT_LABEL=Alex (AI)

# ── Recall.ai ────────────────────────────────────────────────────────────────
RECALL_API_KEY=your_recall_api_key_here
# Public WSS URL nginx will proxy to port 8766 (used when creating bots)
RECALL_REALTIME_URL=wss://api.taskora.in.net/realtime
RECALL_REALTIME_WS_PORT=8766
# Optional — only change if your Recall account is in a different region
# RECALL_API_BASE_URL=https://us-west-2.recall.ai/api/v1

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional: leave blank to reuse OPENAI_MODEL
CONTEXT_SUMMARY_MODEL=

# ── Voice replies (ElevenLabs TTS) ───────────────────────────────────────────
ENABLE_VOICE_REPLIES=true
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
ELEVENLABS_LATENCY_MODE=4

# ── Context engine (optional — defaults shown) ────────────────────────────────
CONTEXT_WINDOW_MINUTES=10
CONTEXT_UPDATE_INTERVAL_SECONDS=5
MAX_TRANSCRIPT_TOKENS=4000
SUMMARY_UPDATE_THRESHOLD=500

# ── Trigger engine (optional — defaults shown) ────────────────────────────────
TRIGGER_CHECK_INTERVAL_MS=500
DECISION_CONFIDENCE_THRESHOLD=0.7
CONFLICT_SENSITIVITY=medium
ENABLE_PROACTIVE_MESSAGES=true
TOPIC_DRIFT_SIMILARITY_THRESHOLD=0.18
TOPIC_DRIFT_MIN_TOKENS=8

# ── Chat (optional — defaults shown) ─────────────────────────────────────────
MAX_MESSAGE_LINES=3
MAX_MESSAGE_CHARS=280
MIN_SECONDS_BETWEEN_PROACTIVE=30
COOLDOWN_AFTER_USER_MESSAGE=5

# ── API security ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://taskora.in.net,https://www.taskora.in.net,https://api.taskora.in.net

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── GitHub Container Registry ────────────────────────────────────────────────
# Used by docker-compose to pull images
GITHUB_ORG=your_github_username_or_org
