# .env.example — copy to .env on the Oracle VM and fill in real values.
# NEVER commit .env to git.

# ── Recall.ai ────────────────────────────────────────────────────────────────
RECALL_API_KEY=your_recall_api_key_here
# Public WSS URL nginx will proxy to port 8766 (used when creating bots)
RECALL_REALTIME_URL=wss://api.YOUR_DOMAIN/realtime
RECALL_REALTIME_WS_PORT=8766

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo-preview

# ── Bot identity ──────────────────────────────────────────────────────────────
BOT_NAME=Alex
BOT_LABEL=Alex (AI)

# ── API security ──────────────────────────────────────────────────────────────
# Comma-separated allowed CORS origins. Set to your domain in production.
ALLOWED_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── GitHub Container Registry ────────────────────────────────────────────────
# Used by docker-compose to pull images
GITHUB_ORG=your_github_username_or_org
