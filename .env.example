# ===========================================
# Real-Time AI Meeting Assistant Configuration
# ===========================================
# 
# QUICK START (Minimum required):
#   1. Get OpenAI key: https://platform.openai.com/api-keys (~$5 credit)
#   2. Fill in OPENAI_API_KEY below
#   3. Fill in ELEVENLABS_API_KEY below if you want spoken replies
#   4. Run: python -m src.main --simulate
#
# For Teams/Zoom: Get Recall.ai key (see below)
#
# ===========================================

# Bot Identity
BOT_NAME=Alex
BOT_LABEL="Alex (AI)"

# ===========================================
# LLM Provider
# ===========================================
# ACTIVE: OpenAI (easiest setup, pay-as-you-go ~$0.01/response)
# Get key at: https://platform.openai.com/api-keys
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo-preview
# Optional: separate model for background historical-context cleanup.
# Leave unset to reuse OPENAI_MODEL. For lower cost, keep this on gpt-4o-mini.
CONTEXT_SUMMARY_MODEL=

# -------------------------------------------
# [FUTURE] Anthropic - Claude models
# Get key at: https://console.anthropic.com/
# -------------------------------------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# -------------------------------------------
# [FUTURE] Azure OpenAI - Enterprise option
# Requires Azure subscription
# -------------------------------------------
# LLM_PROVIDER=azure_openai
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4-turbo

# ===========================================
# Recall.ai (Teams + Zoom meeting bot)
# ===========================================
# Recall.ai sends a bot into Teams/Zoom meetings.
# Sign up: https://recall.ai  (free tier available)
#
# REQUIRED for Teams/Zoom meetings:
RECALL_API_KEY=your-recall-api-key
# RECALL_API_BASE_URL=https://us-west-2.recall.ai/api/v1
# RECALL_REALTIME_WS_PORT=8766
# RECALL_REALTIME_URL=wss://xxx.trycloudflare.com

# ===========================================
# Context Engine Settings
# ===========================================
CONTEXT_WINDOW_MINUTES=10
CONTEXT_UPDATE_INTERVAL_SECONDS=5
MAX_TRANSCRIPT_TOKENS=4000
SUMMARY_UPDATE_THRESHOLD=500  # tokens before re-summarizing

# ===========================================
# Trigger Engine Settings
# ===========================================
TRIGGER_CHECK_INTERVAL_MS=500
DECISION_CONFIDENCE_THRESHOLD=0.7
CONFLICT_SENSITIVITY=medium  # low, medium, high
ENABLE_PROACTIVE_MESSAGES=true

# ===========================================
# Chat Settings
# ===========================================
MAX_MESSAGE_LINES=3
MAX_MESSAGE_CHARS=280
MIN_SECONDS_BETWEEN_PROACTIVE=30
COOLDOWN_AFTER_USER_MESSAGE=5

# ===========================================
# Voice Replies (ElevenLabs TTS)
# ===========================================
# OPTIONAL unless you want spoken replies in Teams/Zoom.
# Sign up: https://elevenlabs.io
ENABLE_VOICE_REPLIES=true
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Default voice from ElevenLabs docs. Replace with any premade/custom voice ID.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
ELEVENLABS_LATENCY_MODE=3

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=json  # json, console
