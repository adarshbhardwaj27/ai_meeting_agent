# ===========================================
# Real-Time AI Meeting Assistant Configuration
# ===========================================
# 
# QUICK START (Minimum required):
#   1. Get OpenAI key: https://platform.openai.com/api-keys (~$5 credit)
#   2. Get Deepgram key: https://console.deepgram.com ($200 FREE credit!)
#   3. Fill in OPENAI_API_KEY and DEEPGRAM_API_KEY below
#   4. Run: python -m src.main --simulate
#
# ===========================================

# Bot Identity
BOT_NAME=Alex
BOT_LABEL="Alex (AI)"

# ===========================================
# LLM Provider
# ===========================================
# ACTIVE: OpenAI (easiest setup, pay-as-you-go ~$0.01/response)
# Get key at: https://platform.openai.com/api-keys
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# -------------------------------------------
# [FUTURE] Anthropic - Claude models
# Get key at: https://console.anthropic.com/
# -------------------------------------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# -------------------------------------------
# [FUTURE] Azure OpenAI - Enterprise option
# Requires Azure subscription
# -------------------------------------------
# LLM_PROVIDER=azure_openai
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4-turbo

# ===========================================
# Speech-to-Text Provider
# ===========================================
# ACTIVE: Deepgram (best latency, $200 FREE credit!)
# Get key at: https://console.deepgram.com/
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=your-deepgram-key

# -------------------------------------------
# [FUTURE] Google Cloud Speech
# Requires GCP account + service account JSON
# -------------------------------------------
# STT_PROVIDER=google
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# -------------------------------------------
# [FUTURE] Azure Speech Services
# Requires Azure subscription
# -------------------------------------------
# STT_PROVIDER=azure
# AZURE_SPEECH_KEY=your-azure-speech-key
# AZURE_SPEECH_REGION=eastus

# ===========================================
# Meeting Platform Credentials
# ===========================================
# ACTIVE: Google Meet (uses browser automation via Playwright)
# NO API KEY NEEDED - bot joins meetings using browser!
# Just install Playwright: pip install playwright && playwright install
#
# Optional: OAuth credentials for better API integration (not required for MVP)
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REFRESH_TOKEN=your-refresh-token

# -------------------------------------------
# [FUTURE] Microsoft Teams
# Requires: Azure AD App + Bot Framework registration
# Docs: https://docs.microsoft.com/en-us/microsoftteams/platform/bots/
# -------------------------------------------
# MS_CLIENT_ID=your-ms-client-id
# MS_CLIENT_SECRET=your-ms-client-secret
# MS_TENANT_ID=your-tenant-id

# -------------------------------------------
# [FUTURE] Zoom
# Requires: Zoom Developer account + Meeting SDK
# Docs: https://developers.zoom.us/docs/meeting-sdk/
# -------------------------------------------
# ZOOM_CLIENT_ID=your-zoom-client-id
# ZOOM_CLIENT_SECRET=your-zoom-client-secret
# ZOOM_ACCOUNT_ID=your-account-id

# ===========================================
# Context Engine Settings
# ===========================================
CONTEXT_WINDOW_MINUTES=10
CONTEXT_UPDATE_INTERVAL_SECONDS=5
MAX_TRANSCRIPT_TOKENS=4000
SUMMARY_UPDATE_THRESHOLD=500  # tokens before re-summarizing

# ===========================================
# Trigger Engine Settings
# ===========================================
TRIGGER_CHECK_INTERVAL_MS=500
DECISION_CONFIDENCE_THRESHOLD=0.7
CONFLICT_SENSITIVITY=medium  # low, medium, high
ENABLE_PROACTIVE_MESSAGES=true

# ===========================================
# Chat Settings
# ===========================================
MAX_MESSAGE_LINES=3
MAX_MESSAGE_CHARS=280
MIN_SECONDS_BETWEEN_PROACTIVE=30
COOLDOWN_AFTER_USER_MESSAGE=5

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=json  # json, console
