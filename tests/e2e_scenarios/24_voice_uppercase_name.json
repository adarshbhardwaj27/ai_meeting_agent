{
  "meeting_id": "voice_mixed_case_name",
  "description": "Bot name in different cases — ALEX, Alex, aLeX — all should match (case insensitive)",
  "tags": ["voice-address", "edge-case", "case-sensitivity"],
  "events": [
    {
      "type": "transcript", "speaker": "John",
      "text": "ALEX what is the status?",
