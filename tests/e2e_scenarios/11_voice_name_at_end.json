{
  "meeting_id": "voice_name_at_end",
  "description": "Someone says 'what do you think alex' — name at END of sentence — must NOT trigger",
  "tags": ["voice-address", "negative", "false-positive"],
  "events": [
    {
      "type": "transcript", "speaker": "Mike",
      "text": "what do you think alex",
      "is_final": true, "delay_ms": 0
    },
    { "type": "wait", "delay_ms": 4000 },
    {
      "type": "assert",
